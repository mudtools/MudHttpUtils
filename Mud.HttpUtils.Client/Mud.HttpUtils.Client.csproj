<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net6.0;net8.0;net10.0</TargetFrameworks>
		<PackageId>Mud.HttpUtils.Client</PackageId>
		<Description>Mud HttpUtils 客户端实现，提供 EnhancedHttpClient 与 IHttpClientFactory 集成；基于 System.Text.Json，Native AOT 与裁剪兼容。</Description>
		<PackageTags>HttpUtils;HttpClient;WebAPI;IHttpClientFactory;EnhancedHttpClient;加密;脱敏;HMAC;DI;Mud HttpUtils;AOT;NativeAOT</PackageTags>
		<Product>Mud Http Utils</Product>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<!-- RS0026（PublicApiAnalyzers）：本库刻意为若干公共成员同时提供「可选参数重载」组合，
		     用于在不破坏既有调用点的前提下扩展能力：
		       · TokenRecoveryExecutor / TokenRecoveryDelegatingHandler —— 新增 IAppContextHolder
		         参数时保留旧构造签名（同一可选参数集的两个重载）；
		       · StreamNdJsonAsync —— 非 AOT 重载与 JsonTypeInfo<T> AOT 重载并存；
		       · StandardOAuth2TokenManager.GetTokenAsync —— 同时实现 ITokenManager 的两个重载。
		     按 RS0026 建议去掉可选参数会直接造成消费方源码破坏性变更，故显式登记该权衡。 -->
		<NoWarn>$(NoWarn);RS0026</NoWarn>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="..\Mud.HttpUtils.Abstractions\Mud.HttpUtils.Abstractions.csproj" />
	</ItemGroup>
	<ItemGroup>
		<!-- [A-3] Polyfill 单一来源化：链接编译 Abstractions 的 internal Polyfill（内部裁剪注解类型），
		     消除 Client 内部的重复定义。仅链接 internal 4 个：
		     - public 3 个（IsExternalInit / RequiresUnreferencedCode / RequiresDynamicCode）不链接：
		       会进入 Client 公共 API 面（PublicAPI 门禁 RS0016）且与 M.E.L.Abstractions 转递类型产生 CS0436；
		     - internal 类型仅在源内编译，不跨程序集可见，无冲突。
		     文件内部自带 #if !NET7_0_OR_GREATER guard，高版本 TFM 编译为空。 -->
		<Compile Include="..\Mud.HttpUtils.Abstractions\Polyfills\UnconditionalSuppressMessageAttribute.cs" Link="Polyfills\UnconditionalSuppressMessageAttribute.cs" Visible="false" />
		<Compile Include="..\Mud.HttpUtils.Abstractions\Polyfills\DynamicDependencyAttribute.cs" Link="Polyfills\DynamicDependencyAttribute.cs" Visible="false" />
		<Compile Include="..\Mud.HttpUtils.Abstractions\Polyfills\DynamicallyAccessedMemberTypes.cs" Link="Polyfills\DynamicallyAccessedMemberTypes.cs" Visible="false" />
		<Compile Include="..\Mud.HttpUtils.Abstractions\Polyfills\DynamicallyAccessedMembersAttribute.cs" Link="Polyfills\DynamicallyAccessedMembersAttribute.cs" Visible="false" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0' or '$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.9" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.9" />
		<PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.9" />
		<PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.9" />
		<PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.9" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net6.0' or '$(TargetFramework)' == 'netstandard2.0'">
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
		<PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
		<PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1" />
		<PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="8.0.1" />
		<PackageReference Include="System.Text.Json" Version="8.0.6" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
		<PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
		<PackageReference Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
	</ItemGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="Mud.HttpUtils.Resilience" />
		<InternalsVisibleTo Include="Mud.HttpUtils.Resilience.Tests" />
		<InternalsVisibleTo Include="Mud.HttpUtils.Client.Tests" />
		<InternalsVisibleTo Include="Mud.HttpUtils.Integration.Tests" />
		<InternalsVisibleTo Include="AotVerificationDemo" />
		<InternalsVisibleTo Include="AotPackageRefDemo" />
	</ItemGroup>
	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="..\Icon.png" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
