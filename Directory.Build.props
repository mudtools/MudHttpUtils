<Project>
	<PropertyGroup>
		<Version>2.0.4</Version>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<PackageProjectUrl>http://www.mudtools.cn/</PackageProjectUrl>
		<RepositoryUrl>https://github.com/mudtools/MudHttpUtils</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageIcon>Icon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageTags>Mud;MudTools;Roslyn;SourceGenerator;CodeGenerator;代码生成器;ASP.NET;ASP.NET Core;.NET;.NET Core;</PackageTags>
		<NoDefaultExcludes>true</NoDefaultExcludes>
		<Copyright>© 2019-2026 Mud Studio Co.,Ltd.</Copyright>
		<Authors>Mud Studio</Authors>
		<Company>Mud Studio</Company>
		<LangVersion>latest</LangVersion>
		<NoWarn>CA1707;CA1021;CA1822;RS1035;NETSDK1210</NoWarn>
		<AnalyzerLanguage>cs</AnalyzerLanguage>
		<InjectIsExternalInitOnLegacy>true</InjectIsExternalInitOnLegacy>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
		<BaseOutputPath>..\bin</BaseOutputPath>
	</PropertyGroup>

	<!-- AOT 兼容性配置：仅在 .NET 8+ TFM 上启用 AOT 分析器。
	     netstandard2.0 和 net6.0 不支持 AOT 分析器，设置 IsAotCompatible 无实际效果。
	     各 csproj 不再单独设置 IsAotCompatible/EnableAotAnalyzer，统一由此处管控。 -->
	<PropertyGroup Condition="'$(TargetFramework)' != 'netstandard2.0' AND '$(TargetFramework)' != 'net6.0' AND '$(IsAotCompatible)' == ''">
		<IsAotCompatible>true</IsAotCompatible>
		<EnableAotAnalyzer>true</EnableAotAnalyzer>
	</PropertyGroup>

	<!-- netstandard2.0/net6.0 不支持 AOT 分析器，抑制 NETSDK1210 噪声告警 -->
	<PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.0' OR '$(TargetFramework)' == 'net6.0'">
		<NoWarn>$(NoWarn);NETSDK1210</NoWarn>
	</PropertyGroup>

	<!-- AOT 严格模式：通过 -p:AotStrictMode=true 激活，将 AOT 相关诊断精确清单式升级为错误。
	     作用域 = 库 + Demo（排除 *.Tests / *.Benchmarks：测试与基准代码不是 AOT 交付物，
	     其反射/动态代码用法属测试基建，纳入严格模式只会产生噪声）。
	     此前该清单分散定义在 3 个 Demo csproj 中，且 MSBuild 项目属性不向被 ProjectReference 的库传播，
	     导致"库内 IL 告警永远不失败、CI 严格模式名不副实"。上移后库工程同样受检（防回归）。 -->
	<PropertyGroup Condition="'$(AotStrictMode)' == 'true' AND !$(MSBuildProjectName.EndsWith('.Tests')) AND !$(MSBuildProjectName.EndsWith('.Benchmarks'))">
		<WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2046;IL2050;IL2057;IL2067;IL2070;IL2072;IL2075;IL2080;IL2091;IL3050;IL3051;AOT004;AOT005;AOT006;AOT007</WarningsAsErrors>
	</PropertyGroup>
</Project>