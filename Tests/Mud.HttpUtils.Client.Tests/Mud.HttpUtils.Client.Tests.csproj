<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net6.0;net8.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>13.0</LangVersion>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<!-- 不再单独开启 AOT 分析器：测试工程不属 AOT 交付物（见 Tests/Directory.Build.props
		     与 Directory.Build.targets 的 AotStrictMode 排除清单），而用例中大量对
		     JsonSerializer.Deserialize / ConfigurationBinder.Bind / XmlSerializer 的调用
		     是**刻意**覆盖非 AOT 路径，只会产生 490+ 条不可消除的 IL3050。
		     库侧 AOT 契约仍由两处独立守卫：(a) 库工程的 AotStrictMode 把 IL2026/IL3050 升为 error；
		     (b) AotAttributeAnnotationTests 以反射断言库成员的 RUC/RDC 标注存在——该用例与
		         本分析器开关无关。 -->
	</PropertyGroup>

	<!-- TMR-13: net6.0 不兼容的测试文件用条件编译排除 -->
	<!-- TMX-20（P1）：AotAttributeAnnotationTests 原因 polyfill internal 而在 net6.0 排除；
	     polyfill 恢复 public 后恢复纳入 net6.0 编译（兼作 P1 回归护栏）。 -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net6.0'">
		<Compile Remove="ConfigP0FixTests.cs" />
		<Compile Remove="SsrfProtectionTests.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
		<PackageReference Include="xunit" Version="2.9.2" />
		<PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="coverlet.collector" Version="6.0.2">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="FluentAssertions" Version="7.0.0" />
		<PackageReference Include="Moq" Version="4.20.72" />
	</ItemGroup>

	<!-- Microsoft.Extensions.* 10.x 官方不支持 net6.0（其 buildTransitive targets 会发出
	     "doesn't support net6.0" 告警）。按 TFM 切分版本，口径与 Mud.HttpUtils.Client 库
	     自身的依赖切分一致：net6.0 用 8.0.x，net8.0/net10.0 用 10.0.9。 -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net6.0'">
		<PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' != 'net6.0'">
		<PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.9" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Mud.HttpUtils.Client\Mud.HttpUtils.Client.csproj" />
		<ProjectReference Include="..\..\Mud.HttpUtils.Xml\Mud.HttpUtils.Xml.csproj" />
		<ProjectReference Include="..\..\Mud.HttpUtils.Abstractions\Mud.HttpUtils.Abstractions.csproj" />
		<ProjectReference Include="..\..\Mud.HttpUtils.Attributes\Mud.HttpUtils.Attributes.csproj" />
		<ProjectReference Include="..\Mud.HttpUtils.Testing\Mud.HttpUtils.Testing.csproj" />
	</ItemGroup>

</Project>
