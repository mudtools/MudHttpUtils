<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<PackageId>Mud.HttpUtils.Attributes</PackageId>
		<Description>Mud HttpUtils 特性定义，提供 HTTP API 声明式标注；仅特性元数据、无运行时反射，AOT 安全。</Description>
		<PackageTags>HttpUtils;HttpClient;WebAPI;特性;Attribute;声明式;REST;Mud HttpUtils;AOT;NativeAOT</PackageTags>
		<Product>Mud Http Utils</Product>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="..\Mud.HttpUtils.Abstractions\Mud.HttpUtils.Abstractions.csproj" />
	</ItemGroup>
	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="..\Icon.png" Pack="true" PackagePath="\" />
		<None Include="build\Mud.HttpUtils.Attributes.targets" Pack="true" PackagePath="build" />
		<None Include="build\Mud.HttpUtils.JsonContextScaffolder.targets" Pack="true" PackagePath="build" />
	</ItemGroup>
</Project>
