<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsAotCompatible>true</IsAotCompatible>
		<PublishAot>true</PublishAot>
		<!-- [v4 Phase 2] 启用 TrimMode=full 验证完整裁剪模式。
		     AotVerificationDemo 使用默认的 TrimMode=partial（仅裁剪明确未使用的程序集），
		     本项目启用 full 模式（裁剪所有程序集中的未使用成员），验证库代码是否有遗漏的反射依赖。 -->
		<TrimMode>full</TrimMode>
		<!-- 关闭单警告模式，使所有裁剪告警都可见 -->
		<TrimmerSingleWarn>false</TrimmerSingleWarn>
		<InvariantGlobalization>true</InvariantGlobalization>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
	</PropertyGroup>

	<!-- AOT 严格模式清单定义在 Directory.Build.targets（全仓统一口径），此处不再重复定义。 -->

	<ItemGroup>
		<ProjectReference Include="..\..\Mud.HttpUtils.Client\Mud.HttpUtils.Client.csproj" />
		<ProjectReference Include="..\..\Mud.HttpUtils.Attributes\Mud.HttpUtils.Attributes.csproj" />
		<ProjectReference Include="..\..\Mud.HttpUtils.Generator\Mud.HttpUtils.Generator.csproj" OutputItemType="Analyzer" />
		<ProjectReference Include="..\..\Mud.HttpUtils.Resilience\Mud.HttpUtils.Resilience.csproj" />
	</ItemGroup>

	<ItemGroup>
		<CompilerVisibleProperty Include="IsAotCompatible" />
		<CompilerVisibleProperty Include="PublishAot" />
		<!-- 与包路径（Mud.HttpUtils.Generator.props）保持一致：Nullable → 生成代码 #nullable enable；
		     HttpClientOptionsName → 生成的 Options 类名。缺失时读取恒取默认值，配置静默失效。 -->
		<CompilerVisibleProperty Include="Nullable" />
		<CompilerVisibleProperty Include="HttpClientOptionsName" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
	</ItemGroup>

</Project>
