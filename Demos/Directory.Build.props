<Project>

	<!-- 显式导入仓库根 Directory.Build.props（就近遮蔽规则，见 Tests/Directory.Build.props 的说明）。 -->
	<Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />

	<PropertyGroup>
		<!-- 示例工程不是交付物：不生成 XML 文档。
		     此前各示例（含已合并删除的 CommonClassLibrary 族公共库壳工程）逐个或继承根属性
		     true 产生 CS1591。此处统一收敛。ToolSurface 消费方的文档注释由生成器语法树回退
	     读取（Extractors.GetDocSummary），不依赖此开关。 -->
		<GenerateDocumentationFile>false</GenerateDocumentationFile>

		<!-- 示例工程不是交付物：关闭 AOT/裁剪分析器（与 Tests/Directory.Build.props 同一先例）。
		     示例常用反射式 JsonSerializer.Serialize(匿名对象)，在根属性全局 IsAotCompatible=true
		     下必然产生 IL2026/IL3050，但对 demo 而言是噪音。 -->
		<IsAotCompatible>false</IsAotCompatible>
		<EnableAotAnalyzer>false</EnableAotAnalyzer>
		<EnableTrimAnalyzer>false</EnableTrimAnalyzer>
	</PropertyGroup>

</Project>
