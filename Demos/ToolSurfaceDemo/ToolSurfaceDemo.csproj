<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- 程序集名必须等于剖面 OwnerAssembly 槽：
		     Names/Contracts/Args/Registrars/Guidance 只发射进 owner 程序集（§5.2-2 owner 门槛）。 -->
	</PropertyGroup>

	<ItemGroup>
		<!-- SDK 程序集：Tier R 能力目录按程序集名 == SdkNamespaceRoot 定位它 -->
		<ProjectReference Include="..\Mud.Demo.Sdk\Mud.Demo.Sdk.csproj" />
		<ProjectReference Include="..\..\Mud.HttpUtils.Attributes\Mud.HttpUtils.Attributes.csproj" />
		<!-- 工具面引擎（含全部源生成器）：以分析器形态接入，不参与运行时引用 -->
		<ProjectReference Include="..\..\Mud.HttpUtils.Generator\Mud.HttpUtils.Generator.csproj" OutputItemType="Analyzer" />
	</ItemGroup>

	<ItemGroup>
		<!-- 生成的 DI 装配产物引用 IServiceCollection / TryAddSingleton / GetRequiredService -->
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
	</ItemGroup>

	<PropertyGroup>
		<!-- Tier R 能力目录开关值（剖面 CapabilityCatalogPropertyName 槽） -->
		<DemoToolCatalog>true</DemoToolCatalog>
	</PropertyGroup>

	<ItemGroup>
		<!-- Tier R 能力目录开关（剖面 CapabilityCatalogPropertyName 槽）：
		     §5.3 v2.1 消费方注册义务——组件侧不预注册消费方属性，须由消费方自行
		     CompilerVisibleProperty 注册（属性值定义见上方 PropertyGroup）。 -->
		<CompilerVisibleProperty Include="DemoToolCatalog" />
	</ItemGroup>

	<ItemGroup>
		<!-- Guidance 资产：AdditionalFiles 进入编译，剖面 GuidanceDirectory 槽（/Guidance/）按路径归属 -->
		<AdditionalFiles Include="Guidance\**\*.md" />
	</ItemGroup>

</Project>
