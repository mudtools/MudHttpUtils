<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsAotCompatible>true</IsAotCompatible>
		<PublishAot>true</PublishAot>
		<!-- [v1.5 Phase 1.3] 启用 InvariantGlobalization 验证全球化裁剪路径。
		     暂不开 TrimMode=full（v1.4 修正：OTLP Exporter Protobuf 反射在 full 裁剪下有已知风险）。 -->
		<InvariantGlobalization>true</InvariantGlobalization>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<!-- net8.0 / net10.0 内层构建串行化：两个 TFM 并行时都会执行
		     GenerateJsonContext → `dotnet run`（内含对脚手架工程的构建），
		     并发写同一个 Tools/.../obj 输出会相互抢占文件锁，报 CS2012/MSB3073。
		     串行化后先后执行，各自构建脚手架互不干扰（第二次为增量，开销很小）。 -->
		<BuildInParallel>false</BuildInParallel>
	</PropertyGroup>

	<!-- AOT 分析器在构建时启用（PublishAot=true 自动启用），
	     IL 告警作为警告显示。CI 中 dotnet publish -p:PublishAot=true 为最终验证。
	     严格模式（-p:AotStrictMode=true）的 WarningsAsErrors 清单定义在 Directory.Build.targets，
	     全仓（库 + Demo）统一口径，此处不再重复定义。 -->

	<ItemGroup>
		<ProjectReference Include="..\..\Mud.HttpUtils.Client\Mud.HttpUtils.Client.csproj" />
		<ProjectReference Include="..\..\Mud.HttpUtils.Attributes\Mud.HttpUtils.Attributes.csproj" />
		<ProjectReference Include="..\..\Mud.HttpUtils.Generator\Mud.HttpUtils.Generator.csproj" OutputItemType="Analyzer" />
		<ProjectReference Include="..\..\Mud.HttpUtils.Resilience\Mud.HttpUtils.Resilience.csproj" />
	</ItemGroup>

	<!-- [AOT v4 Phase 18.0 / D18] Generator 以 OutputItemType="Analyzer" 方式 ProjectReference 引用时，
	     包内 build/*.props 不会被自动导入，需在此显式注册 CompilerVisibleProperty，
	     使 AotXmlRejectionAnalyzer 能读取 build_property.IsAotCompatible / build_property.PublishAot。 -->
	<ItemGroup>
		<CompilerVisibleProperty Include="IsAotCompatible" />
		<CompilerVisibleProperty Include="PublishAot" />
		<!-- 与包路径（Mud.HttpUtils.Generator.props）保持一致：Nullable 决定生成代码是否发射
		     #nullable enable；HttpClientOptionsName 决定生成的 Options 类名（读取 build_property.*）。 -->
		<CompilerVisibleProperty Include="Nullable" />
		<CompilerVisibleProperty Include="HttpClientOptionsName" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
	</ItemGroup>

	<!-- ─────────────────────────────────────────────────────────────
	     Pre-build：JSON Context 脚手架（Mud.HttpUtils.JsonContextScaffolder）
	     在编译前扫描标注 [HttpJsonSerializable] 的实体，自动生成 AppJsonContext.g.cs
	     到 obj/<tfm>/GeneratedJsonContext/，作为真实编译源参与 STJ 源生成。
	     手写补充（List<UserDto> 等）见 JsonContext.cs。
	     机制对应方案文档 §3.2（pre-build 产出真实 .g.cs，绕过 Roslyn 生成器互不可见限制）。
	     ───────────────────────────────────────────────────────────── -->
	<PropertyGroup>
		<ScaffolderProject>$(MSBuildThisFileDirectory)..\..\Tools\Mud.HttpUtils.JsonContextScaffolder\Mud.HttpUtils.JsonContextScaffolder.csproj</ScaffolderProject>
		<ScaffolderDir>$(MSBuildThisFileDirectory)..\..\Tools\Mud.HttpUtils.JsonContextScaffolder</ScaffolderDir>
	</PropertyGroup>

	<!-- 脚手架工具源码参与 GenerateJsonContext 的增量判定（Inputs）。
	     否则工具自身升级（如 typeof() 类型限定符生成规则变化）后，obj 下的旧 .g.cs
	     不会重新生成，陈旧产物继续参与编译并报 CS0246 等错误。 -->
	<ItemGroup>
		<ScaffolderSource Include="$(ScaffolderDir)\**\*.cs"
		                  Exclude="$(ScaffolderDir)\obj\**;$(ScaffolderDir)\bin\**" />
	</ItemGroup>

	<!-- 运行脚手架：仅在源码较新时重新生成（增量）。
	     注意（重要）：脚手架内部使用 MSBuildWorkspace 评估本项目，而 MSBuildWorkspace 会发起
	     "设计时构建"（DesignTimeBuild=true）并同样执行 BeforeCompile 目标。若本目标不加防护，
	     嵌套评估会再次触发本目标 → `dotnet run 脚手架` → 再次嵌套 …… 形成**无限递归**，
	     表现为构建进程不断派生新的 dotnet 进程、构建永不结束。故必须同时满足：
	       1) 跳过设计时构建（'$(DesignTimeBuild)' != 'true'）；
	       2) 以环境变量 MudJsonContextScaffolderRunning 做重入保护（嵌套评估可见该进程环境变量，
	          从而在 MSBuild 属性层面表现为 'true'）。
	     另：清除外层注入的 MSBuild 环境变量，否则嵌套评估会因 SDK/Exe 路径冲突而失败。 -->
	<Target Name="GenerateJsonContext"
	        BeforeTargets="BeforeCompile"
	        Inputs="$(MSBuildProjectFile);@(Compile);$(ScaffolderProject);@(ScaffolderSource)"
	        Outputs="$(IntermediateOutputPath)GeneratedJsonContext\AppJsonContext.g.cs"
	        Condition="'$(DesignTimeBuild)' != 'true' AND '$(MudJsonContextScaffolderRunning)' != 'true' AND Exists('$(ScaffolderProject)')">
		<Message Importance="high" Text="[JsonContext] 运行脚手架生成 AppJsonContext（pre-build）" />
		<Exec Command="dotnet run --project &quot;$(ScaffolderProject)&quot; -- --project &quot;$(MSBuildProjectFullPath)&quot; -o &quot;$(IntermediateOutputPath)GeneratedJsonContext&quot;"
		      EnvironmentVariables="MSBUILD_EXE_PATH=;MSBuildEnableNodeReuse=false;MudJsonContextScaffolderRunning=true" />
	</Target>

	<!-- 将生成文件纳入编译（obj/ 默认被 SDK 排除，需显式 Include） -->
	<Target Name="IncludeGeneratedJsonContext"
	        BeforeTargets="BeforeCompile"
	        DependsOnTargets="GenerateJsonContext">
		<ItemGroup Condition="Exists('$(IntermediateOutputPath)GeneratedJsonContext')">
			<Compile Include="$(IntermediateOutputPath)GeneratedJsonContext\**\*.g.cs" />
			<FileWrites Include="$(IntermediateOutputPath)GeneratedJsonContext\**\*.g.cs" />
		</ItemGroup>
	</Target>

</Project>
