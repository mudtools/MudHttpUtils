<Solution>
  <Folder Name="/Demos/">
    <!-- 三类定位（勿混淆）：
         1) 可运行演示：HttpClientDemo（Client 基础+OTel）、ResilienceDemo（弹性策略+OTel）、
            PayloadDemo（PayloadFieldMap）、ToolSurfaceDemo + Mud.Demo.Sdk（工具面引擎与 SDK 样本程序集，
            SdkNamespaceRoot="Mud.Demo.Sdk" 为引擎契约，程序集名不可改）；
         2) 编译期夹具验证：HttpClientApiDemo.Share（生成器功能夹具库）→ HttpClientApiDemo（本地源码路径验证
            HEAD）与 HttpClientApiPublicDemo（已发布 2.0.9 包路径验证消费方体验）；
         3) CI 专属：AotVerificationDemo（AOT+裁剪发布验证，TrimMode 由 CI 矩阵驱动），不在解决方案内。 -->
    <Project Path="Demos/AotVerificationDemo/AotVerificationDemo.csproj" />
